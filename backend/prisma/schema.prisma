generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id        String    @id @default(uuid())
  email     String    @unique
  firstName String
  lastName  String
  phone     String?
  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ClientAccount {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
}

model ManagerAccount {
  id           Int             @id @default(autoincrement())
  name         String
  identifier   String          @unique
  passwordHash String
  passwordSalt String
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  sessions     ManagerSession[]
}

model ManagerSession {
  tokenHash String         @id
  managerId Int
  manager   ManagerAccount @relation(fields: [managerId], references: [id], onDelete: Cascade)
  expiresAt DateTime       @db.Timestamptz(6)

  @@index([expiresAt])
}

model Destination {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(120)
  country     String   @db.VarChar(120)
  description String?
  trips       Trip[]
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([name, country], map: "destinations_name_country_unique")
  @@map("destinations")
}

model Trip {
  id            String      @id @default(uuid())
  title         String
  price         Decimal     @db.Decimal(10, 2)
  startDate     DateTime
  endDate       DateTime
  capacity      Int
  destination   Destination @relation(fields: [destinationId], references: [id])
  destinationId String      @db.Uuid
  bookings      Booking[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([destinationId])
}

model Booking {
  id        String        @id @default(uuid())
  status    BookingStatus @default(PENDING)
  seats     Int
  total     Decimal       @db.Decimal(10, 2)
  client    Client        @relation(fields: [clientId], references: [id])
  clientId  String
  trip      Trip          @relation(fields: [tripId], references: [id])
  tripId    String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([clientId])
  @@index([tripId])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum TravelRequestStatus {
  PENDING
  NEEDS_INFO
  IN_REVIEW
  PROPOSAL_SENT
  ACCEPTED
  PAYMENT_PENDING
  PAID
  CONFIRMED
  REJECTED
  CANCELLED
  PENDING_REVIEW
  PREPARATION_AVAILABLE
  PREPARATION_IN_PROGRESS
  SUBMITTED
  FEASIBILITY_REVIEW
  CHANGES_REQUESTED
  CONFIRMED_AWAITING_PAYMENT
  REFUSED
  EXPIRED
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum AppointmentRequestStatus {
  PENDING
  CONTACTED
  SCHEDULED
  CANCELLED
}

enum TravelReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model TravelReview {
  id          String            @id @default(uuid())
  clientName  String
  clientEmail String
  destination String?
  rating      Int
  content     String            @db.VarChar(2000)
  status      TravelReviewStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([clientEmail, createdAt])
}

model AppointmentRequest {
  id            String                   @id @default(uuid())
  clientAccountId String?
  clientName    String
  clientEmail   String
  phone         String?
  preferredDate DateTime                 @db.Date
  preferredTime String
  subject       String
  message       String?
  status        AppointmentRequestStatus @default(PENDING)
  emails        AppointmentEmail[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([status, createdAt])
  @@index([clientAccountId, createdAt])
}

model TravelRequest {
  id                         String              @id @default(uuid())
  accessToken                String?             @unique
  preparationTokenHash       String?             @unique
  preparationTokenExpiresAt  DateTime?
  preparationTokenRevokedAt  DateTime?
  clientAccountId            String?
  clientName                 String
  clientEmail                String
  clientPhone                String?
  destination                String
  startDate                  DateTime?
  endDate                    DateTime?
  datePreference             String?
  travelers                  Int                 @default(1)
  budget                     Decimal?            @db.Decimal(10, 2)
  budgetText                 String?
  travelType                 String?
  preferences                String?
  itinerary                  Json?
  status                     TravelRequestStatus @default(PENDING)
  internalNotes              String?
  proposal                   TravelProposal?
  paymentStatus              PaymentStatus       @default(NOT_REQUIRED)
  paymentUrl                 String?
  paymentProviderId          String?
  emails                     RequestEmail[]
  history                    RequestHistory[]
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([clientEmail])
  @@index([clientAccountId, createdAt])
}

model TravelProposal {
  id            String        @id @default(uuid())
  requestId     String        @unique
  request       TravelRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  title         String?
  itinerary     Json
  accommodation String?
  transport     String?
  activities    String?
  totalPrice    Decimal       @db.Decimal(10, 2)
  currency      String        @default("EUR")
  conditions    String?
  version       Int           @default(1)
  sentAt        DateTime?
  acceptedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model RequestEmail {
  id           String        @id @default(uuid())
  requestId    String
  request      TravelRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  recipient    String
  subject      String
  template     String
  status       EmailStatus   @default(PENDING)
  providerId   String?
  errorMessage String?
  sentAt       DateTime?
  createdAt    DateTime      @default(now())

  @@index([requestId, createdAt])
}

model AppointmentEmail {
  id            String             @id @default(uuid())
  appointmentId String
  appointment   AppointmentRequest @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  recipient     String
  subject       String
  status        EmailStatus        @default(PENDING)
  providerId    String?
  errorMessage  String?
  sentAt        DateTime?
  createdAt     DateTime           @default(now())

  @@index([appointmentId, createdAt])
}

model RequestHistory {
  id        String        @id @default(uuid())
  requestId String
  request   TravelRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor     String
  action    String
  details   Json?
  createdAt DateTime      @default(now())

  @@index([requestId, createdAt])
}
