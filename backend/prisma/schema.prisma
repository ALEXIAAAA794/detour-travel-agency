generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id        String    @id @default(uuid())
  email     String    @unique
  firstName String
  lastName  String
  phone     String?
  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Destination {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(120)
  country     String   @db.VarChar(120)
  description String?
  trips       Trip[]
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([name, country], map: "destinations_name_country_unique")
  @@map("destinations")
}

model Trip {
  id            String      @id @default(uuid())
  title         String
  price         Decimal     @db.Decimal(10, 2)
  startDate     DateTime
  endDate       DateTime
  capacity      Int
  destination   Destination @relation(fields: [destinationId], references: [id])
  destinationId String      @db.Uuid
  bookings      Booking[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([destinationId])
}

model Booking {
  id        String        @id @default(uuid())
  status    BookingStatus @default(PENDING)
  seats     Int
  total     Decimal       @db.Decimal(10, 2)
  client    Client        @relation(fields: [clientId], references: [id])
  clientId  String
  trip      Trip          @relation(fields: [tripId], references: [id])
  tripId    String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([clientId])
  @@index([tripId])
}

model TravelRequest {
  id          String              @id @default(uuid())
  accessToken String              @unique @default(uuid())
  name        String
  email       String
  destination String
  departure   DateTime?
  returnDate  DateTime?
  travelers   Int
  budget      String?
  travelType  String?
  preferences String?
  itinerary   Json?
  paymentUrl  String?
  status      TravelRequestStatus @default(PENDING_REVIEW)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([email])
  @@index([status])
}

enum TravelRequestStatus {
  PENDING_REVIEW
  PREPARATION_AVAILABLE
  PREPARATION_IN_PROGRESS
  SUBMITTED
  FEASIBILITY_REVIEW
  CHANGES_REQUESTED
  CONFIRMED_AWAITING_PAYMENT
  PAID
  REFUSED
  EXPIRED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum TravelRequestStatus {
  PENDING
  NEEDS_INFO
  IN_REVIEW
  PROPOSAL_SENT
  ACCEPTED
  PAYMENT_PENDING
  PAID
  CONFIRMED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

model TravelRequest {
  id                String              @id @default(uuid())
  clientName        String
  clientEmail       String
  clientPhone       String?
  destination       String
  startDate         DateTime?
  endDate           DateTime?
  travelers         Int                 @default(1)
  budget            Decimal?            @db.Decimal(10, 2)
  preferences       String?
  status            TravelRequestStatus @default(PENDING)
  internalNotes     String?
  proposal          TravelProposal?
  paymentStatus     PaymentStatus       @default(NOT_REQUIRED)
  paymentUrl        String?
  paymentProviderId String?
  emails            RequestEmail[]
  history           RequestHistory[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([clientEmail])
}

model TravelProposal {
  id            String        @id @default(uuid())
  requestId     String        @unique
  request       TravelRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  title         String?
  itinerary     Json
  accommodation String?
  transport     String?
  activities    String?
  totalPrice    Decimal       @db.Decimal(10, 2)
  currency      String        @default("EUR")
  conditions    String?
  version       Int           @default(1)
  sentAt        DateTime?
  acceptedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model RequestEmail {
  id           String        @id @default(uuid())
  requestId    String
  request      TravelRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  recipient    String
  subject      String
  template     String
  status       EmailStatus   @default(PENDING)
  providerId   String?
  errorMessage String?
  sentAt       DateTime?
  createdAt    DateTime      @default(now())

  @@index([requestId, createdAt])
}

model RequestHistory {
  id        String        @id @default(uuid())
  requestId String
  request   TravelRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor     String
  action    String
  details   Json?
  createdAt DateTime      @default(now())

  @@index([requestId, createdAt])
}
