# Local Docker development only. Keep the PostgreSQL password URL-safe
# (letters, numbers, and underscores) because it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=replace_with_a_local_password
MANAGER_API_KEY=replace_with_a_random_key_of_at_least_24_characters
JWT_SECRET=replace_with_a_random_secret_of_at_least_16_characters
# Optional: configure Resend to send client confirmation emails.
RESEND_API_KEY=
EMAIL_FROM=

# La configuration privée de l’assistant IA reste dans support-ia/.env.
# Gemini utilise un modèle Flash qui a été vérifié disponible pour ce projet.
GEMINI_MODEL=gemini-3.5-flash

# Optional local port overrides
POSTGRES_HOST_PORT=5433
SITE_PORT=5173
MANAGER_UI_PORT=5174
BACKEND_PORT=3000
CLIENT_AUTH_PORT=4000
MANAGER_API_PORT=8081
