GEMINI_API_KEY=remplacez_par_votre_cle

# Choix explicite, aucun repli automatique. Valeurs autorisées : gemini, openrouter.
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash

# OpenRouter : côté serveur uniquement ; modèle explicitement gratuit obligatoire.
# Pour l’activer, remplacer AI_PROVIDER ci-dessus par openrouter.
OPENROUTER_API_KEY=sk-or-v1-CLE_FICTIVE_A_REMPLACER
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free

# Compatibilité #18 : alias facultatif, serveur uniquement. La clé du fournisseur reste prioritaire.
# IA_API_KEY=CLE_FICTIVE_A_REMPLACER
# Origine publique du FRONTEND pour les liens email ; HTTPS obligatoire hors localhost.
SUPPORT_PUBLIC_URL=http://127.0.0.1:3001
# Durée à valider PO : 24 h ; bornes autorisées 300 à 604800 secondes.
SUPPORT_EMAIL_LINK_TTL_SECONDS=86400
# Plafond par minute partagé discussion/génération, par IP et préparation, un processus Express.
SUPPORT_AI_RATE_LIMIT=20
